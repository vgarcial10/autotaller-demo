    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst nombre = body?.cliente?.nombre;\nconst telefono = body?.cliente?.telefono;\nconst placa = body?.vehiculo?.placa;\nconst problema = body?.problema;\n\nif (!nombre || !telefono || !placa || !problema) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Faltan datos obligatorios: nombre, telefono, placa o problema.',\n      payload_recibido: body\n    }\n  }];\n}\n\nfunction generarCodigo(length = 6) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  let code = '';\n  for (let i = 0; i < length; i++) {\n    code += chars[Math.floor(Math.random() * chars.length)];\n  }\n  return code;\n}\n\nreturn [{\n  json: {\n    valid: true,\n    cliente_nombre: nombre,\n    cliente_telefono: telefono,\n    vehiculo_placa: placa,\n    vehiculo_marca: body?.vehiculo?.marca || null,\n    vehiculo_modelo: body?.vehiculo?.modelo || null,\n    problema,\n    codigo_acceso: generarCodigo(),\n    payload_recibido: body\n  }\n}];"
      },
